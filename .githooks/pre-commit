#!/usr/bin/env sh
# Gates locais antes do commit, para não queimar minutos do GitHub Actions.
# Instalar: make hooks. Pular testes: SKIP_TESTS=1 git commit ...
set -e

make lint

if [ "${SKIP_TESTS:-0}" = "1" ]; then
	echo "pre-commit: SKIP_TESTS=1, testes pulados"
	exit 0
fi

if cargo nextest --version >/dev/null 2>&1; then
	cargo nextest run --workspace --fail-fast
else
	cargo test --workspace
fi
